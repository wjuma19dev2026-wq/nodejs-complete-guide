{
  "name": "nodejs-complete-guide",
  "version": "1.0.0",
  "description": "RestApi feeds App",
  "main": "src/index.js",
  "scripts": {
    "start": "babel-node src/index.js",
    "dev": "nodemon --exec babel-node -- --env-file=.env src/index.js",
    "build": "babel src --out-dir dist",
    "build:min": "npm run build && terser-folder dist -e -o dist -x .min.js -c",
    "serve": "node dist/index.js",
    "clean": "rimraf dist",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/node": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-minify": "^0.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "terser": "^5.51.4",
    "terser-folder": "^2.0.0"
  }
}
